+    def _reset_export_buffers(self) -> None:
+        if self.save_embeddings:
+            self.saved_user_id_embeddings = {}
+            self.saved_user_text_embeddings = {}
+            self.saved_user_fused_embeddings = {}
+            self.saved_user_lengths = {}
+        if self.save_user_labels:
+            self.user_ids_to_labels = {}
+
+    def _save_embedding_export(self, split, cand_id, cand_text, cand_fused) -> None:
+        if not self.save_embeddings:
+            return
+        if self.trainer.world_size != 1:
+            raise RuntimeError("Embedding export requires a single process; use a one-device trainer.")
+        sources = ((self.saved_user_fused_embeddings, cand_fused),
+                   (self.saved_user_id_embeddings, cand_id),
+                   (self.saved_user_text_embeddings, cand_text))
+        users, candidates = next(((users, candidates) for users, candidates in sources if users), (None, None))
+        if users is None or candidates is None:
+            raise RuntimeError(f"No {split} embeddings were collected")
+        expected = set(range(len(users)))
+        if set(users) != expected or set(self.saved_user_lengths) != expected:
+            raise RuntimeError(f"{split} user IDs must be unique and contiguous from zero")
+        if self.save_user_labels and set(self.user_ids_to_labels) != expected:
+            raise RuntimeError(f"{split} labels do not match exported user IDs")
+        torch.save(torch.stack([users[i].cpu() for i in range(len(users))]),
+                   f"{self.embeddings_save_path}/{split}_user_embeddings.pt")
+        torch.save(candidates.cpu(), f"{self.embeddings_save_path}/{split}_item_embeddings.pt")
+        # Preserve the upstream notebook's test export filename.
+        if split == "test":
+            torch.save(candidates.cpu(), f"{self.embeddings_save_path}/item_embeddings.pt")
+        torch.save(torch.tensor([self.saved_user_lengths[i] for i in range(len(users))]),
+                   f"{self.embeddings_save_path}/{split}_history_lengths.pt")
+        torch.save(torch.arange(len(users)), f"{self.embeddings_save_path}/{split}_user_ids.pt")
+        if self.save_user_labels:
+            torch.save(torch.tensor([self.user_ids_to_labels[i] for i in range(len(users))]),
+                       f"{self.embeddings_save_path}/{split}_user_labels.pt")
+
     def log_metrics(
         self,
         prefix: str,
